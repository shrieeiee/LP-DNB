// Windows resources: the program icon and the version details shown in
// File Explorer (right-click > Properties > Details).
#include <winver.h>

1 ICON "../assets/icon/lp-dnb.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "shrieeiee"
#ifdef LP_TENORI
      VALUE "FileDescription", "LP-DNB lp-tenori: Tenori-on style sequencer for Novation Launchpad Mini"
#else
      VALUE "FileDescription", "LP-DNB groovebox for Novation Launchpad Mini"
#endif
      VALUE "FileVersion", "1.3.0"
#ifdef LP_TENORI
      VALUE "InternalName", "lp-tenori"
#else
      VALUE "InternalName", "LP-DNB"
#endif
      VALUE "LegalCopyright", "Copyright (c) 2026 shrieeiee, MIT licence. Uses Dear ImGui (MIT), RtMidi (MIT), miniaudio (MIT-0 / public domain), Nunito font (SIL OFL 1.1)."
#ifdef LP_TENORI
      VALUE "OriginalFilename", "lp-tenori.exe"
#else
      VALUE "OriginalFilename", "LP-DNB.exe"
#endif
      VALUE "ProductName", "LP-DNB"
      VALUE "ProductVersion", "1.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
